{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,

    "layout": {
      "contentSize": "820px",
      "wideSize": "1400px"
    },

    "color": {
      "custom": true,
      "customGradient": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "#173449" },
        { "slug": "secondary", "name": "Secondary", "color": "#234A64" },
        { "slug": "accent", "name": "Accent", "color": "#D8A03F" },
        { "slug": "surface", "name": "Surface", "color": "#F7F9FB" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" },
        { "slug": "text", "name": "Text", "color": "#1C252D" }
      ]
    },

    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true,
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },

    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },

    "typography": {
      "customFontSize": true,
      "dropCap": true,
      "fontStyle": true,
      "fontWeight": true,
      "letterSpacing": true,
      "lineHeight": true,
      "textDecoration": true,
      "textTransform": true,
      "writingMode": false,
      "fontFamilies": [
        {
          "slug": "inter",
          "fontFamily": "Inter, sans-serif",
          "name": "Inter"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "0.9rem" },
        { "slug": "medium", "name": "Medium", "size": "1.15rem" },
        { "slug": "large", "name": "Large", "size": "1.5rem" },
        { "slug": "x-large", "name": "Extra Large", "size": "2.25rem" },
        { "slug": "xx-large", "name": "Hero", "size": "clamp(3.2rem, 7vw, 6rem)" }
      ]
    },

    "dimensions": {
      "minHeight": true
    },

    "position": {
      "sticky": true
    },

    "blocks": {
      "core/button": {
        "color": {
          "custom": true
        },
        "border": {
          "color": true,
          "radius": true,
          "style": true,
          "width": true
        },
        "spacing": {
          "padding": true,
          "margin": true
        },
        "typography": {
          "fontSize": true,
          "fontWeight": true,
          "textTransform": true
        }
      },

      "core/group": {
        "color": {
          "custom": true,
          "customGradient": true
        },
        "spacing": {
          "padding": true,
          "margin": true,
          "blockGap": true
        },
        "border": {
          "color": true,
          "radius": true,
          "style": true,
          "width": true
        },
        "dimensions": {
          "minHeight": true
        }
      },

      "core/cover": {
        "color": {
          "custom": true
        },
        "spacing": {
          "padding": true,
          "margin": true
        },
        "dimensions": {
          "minHeight": true
        }
      },

      "core/columns": {
        "spacing": {
          "padding": true,
          "margin": true,
          "blockGap": true
        }
      },

      "core/column": {
        "color": {
          "custom": true
        },
        "spacing": {
          "padding": true,
          "margin": true
        },
        "border": {
          "color": true,
          "radius": true,
          "style": true,
          "width": true
        }
      },

      "core/heading": {
        "color": {
          "custom": true
        },
        "typography": {
          "fontSize": true,
          "fontWeight": true,
          "lineHeight": true,
          "letterSpacing": true,
          "textTransform": true
        },
        "spacing": {
          "margin": true
        }
      },

      "core/paragraph": {
        "color": {
          "custom": true
        },
        "typography": {
          "fontSize": true,
          "fontWeight": true,
          "lineHeight": true,
          "letterSpacing": true
        },
        "spacing": {
          "margin": true
        }
      },

      "core/image": {
        "border": {
          "color": true,
          "radius": true,
          "style": true,
          "width": true
        },
        "spacing": {
          "margin": true
        }
      }
    }
  },

  "customTemplates": [
    { "name": "page-products", "title": "Products Page", "postTypes": ["page"] },
    { "name": "page-industries", "title": "Industries Page", "postTypes": ["page"] },
    { "name": "page-documentation", "title": "Documentation Page", "postTypes": ["page"] },
    { "name": "page-partners", "title": "Partners Page", "postTypes": ["page"] },
    { "name": "page-contact", "title": "Contact Page", "postTypes": ["page"] },
    { "name": "page-account", "title": "Account Page", "postTypes": ["page"] }
  ],

  "styles": {
    "spacing": {
      "blockGap": "0"
    },
    "color": {
      "background": "#FFFFFF",
      "text": "#1C252D"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "lineHeight": "1.7"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "10px"
        },
        "typography": {
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      }
    }
  }
}